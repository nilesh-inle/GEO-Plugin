{%- comment -%}
  Product JSON-LD. Expects `product` and `geo` (GEO settings metafield).
  All strings go through the `json` filter so quotes and line breaks can't break the JSON.
  Optional properties end with a comma; each object ends with a required property.
{%- endcomment -%}
{%- liquid
  assign origin = request.origin
  assign product_url = origin | append: product.url
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign shipping = geo.shipping
-%}

{%- capture shipping_json -%}
  {%- if shipping -%}
  {
    "@type": "OfferShippingDetails",
    "shippingRate": { "@type": "MonetaryAmount", "value": {{ shipping.rate | json }}, "currency": {{ shipping.currency | json }} },
    "shippingDestination": [
      {%- for country in shipping.countries -%}
        { "@type": "DefinedRegion", "addressCountry": {{ country | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "deliveryTime": {
      "@type": "ShippingDeliveryTime",
      "handlingTime": { "@type": "QuantitativeValue", "minValue": {{ shipping.handling_min | json }}, "maxValue": {{ shipping.handling_max | json }}, "unitCode": "DAY" },
      "transitTime": { "@type": "QuantitativeValue", "minValue": {{ shipping.transit_min | json }}, "maxValue": {{ shipping.transit_max | json }}, "unitCode": "DAY" }
    }
  }
  {%- endif -%}
{%- endcapture -%}

{%- capture returns_json -%}
  {%- if geo.returns -%}{%- render 'geo-return-policy', returns: geo.returns -%}{%- endif -%}
{%- endcapture -%}

<script type="application/ld+json" data-geo-schema>
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ product_url | append: '#product' | json }},
  {%- if product.description != blank %}
  "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
  {%- endif %}
  {%- if product.featured_image %}
  "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
  {%- endif %}
  {%- if product.vendor != blank %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
  {%- endif %}
  {%- if rating and rating_count > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating.rating | json }},
    "bestRating": {{ rating.scale_max | json }},
    "worstRating": {{ rating.scale_min | json }},
    "ratingCount": {{ rating_count | json }}
  },
  {%- endif %}
  "offers": [
    {%- for variant in product.variants -%}
      {%- comment -%} GTIN-8, -12, -13 or -14, digits only (same rule as the app's sync). {%- endcomment -%}
      {%- liquid
        assign gtin = false
        assign barcode = variant.barcode | strip
        assign barcode_size = barcode.size
        if barcode_size == 8 or barcode_size == 12 or barcode_size == 13 or barcode_size == 14
          assign non_digits = barcode | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9'
          if non_digits == ''
            assign gtin = barcode
          endif
        endif
      -%}
      {
        "@type": "Offer",
        "url": {{ origin | append: variant.url | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
        "itemCondition": "https://schema.org/NewCondition",
        {%- if variant.sku != blank %} "sku": {{ variant.sku | json }},{% endif %}
        {%- if gtin %} "gtin": {{ gtin | json }},{% endif %}
        {%- if shipping_json != blank %} "shippingDetails": {{ shipping_json }},{% endif %}
        {%- if returns_json != blank %} "hasMerchantReturnPolicy": {{ returns_json }},{% endif %}
        "seller": { "@type": "Organization", "name": {{ shop.name | json }} }
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ],
  "name": {{ product.title | json }},
  "url": {{ product_url | json }}
}
</script>

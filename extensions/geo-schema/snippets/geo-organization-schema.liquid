{%- comment -%}
  Organization JSON-LD for the home page. Expects `geo` (GEO settings metafield).
{%- endcomment -%}
{%- liquid
  assign origin = request.origin
  assign description = shop.brand.short_description | default: shop.description
-%}

{%- capture returns_json -%}
  {%- if geo.returns -%}{%- render 'geo-return-policy', returns: geo.returns -%}{%- endif -%}
{%- endcapture -%}

<script type="application/ld+json" data-geo-schema>
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": {{ origin | append: '/#organization' | json }},
  {%- if shop.brand.logo %}
  "logo": {{ shop.brand.logo | image_url: width: 600 | prepend: 'https:' | json }},
  {%- endif %}
  {%- if description != blank %}
  "description": {{ description | strip_html | strip | json }},
  {%- endif %}
  {%- if shop.email != blank %}
  "email": {{ shop.email | json }},
  {%- endif %}
  {%- if returns_json != blank %}
  "hasMerchantReturnPolicy": {{ returns_json }},
  {%- endif %}
  "name": {{ shop.name | json }},
  "url": {{ origin | json }}
}
</script>
